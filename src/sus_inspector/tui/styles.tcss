#tree-pane {
    width: 30%;
    border: solid $primary;
    overflow-x: auto;
}

#detail-container {
    width: 70%;
}

#detail-pane {
    height: 1fr;
    border: solid $secondary;
    overflow-y: scroll;
}

#class-pane {
    height: 1fr;
    border: solid yellow;
    display: none;
    overflow-y: scroll;
}

Breadcrumbs {
    height: 1;
    background: $boost;
    padding: 0 1;
    width: 100%;
    overflow: hidden;
}

.bc-button {
    min-width: 0;
    height: 1;
    border: none;
    background: transparent;
    color: $text;
    padding: 0 1;
    margin: 0;
    content-align: center middle;
}

.bc-button:hover {
    background: $accent;
    color: $text;
}

.bc-separator {
    color: $text-disabled;
}

#search-bar {
    dock: bottom;
    display: none;
}

HistoryModal {
    align: center middle;
}

#history-container {
    width: 60%;
    height: 60%;
    background: $surface;
    border: thick $primary;
    padding: 1;
}

#history-title {
    width: 100%;
    text-align: center;
    background: $primary;
    color: $text;
    text-style: bold;
    margin-bottom: 1;
}

#history-list {
    height: 1fr;
    border: solid $secondary;
}

#history-footer {
    width: 100%;
    text-align: center;
    color: $text-disabled;
    margin-top: 1;
}
