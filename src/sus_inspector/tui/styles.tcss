#tree-pane {
    width: 30%;
    border: solid $primary;
    overflow-x: auto;
}

#detail-container {
    width: 70%;
}

#detail-pane {
    width: 1fr;
    height: 100%;
    border: solid $secondary;
    overflow-y: scroll;
}

#class-pane {
    width: 1fr;
    height: 100%;
    border: solid yellow;
    display: none;
    overflow-y: scroll;
}

#path-bar {
    dock: bottom;
    background: $accent;
}

#search-bar {
    dock: bottom;
    display: none;
}
